{
  "name": "wolffia-ui",
  "version": "0.1.7",
  "description": "Wolffia 本地音乐播放器的桌面前端，支持同步歌词显示",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --outDir ../src/wolffia/ui --emptyOutDir",
    "preview": "vite preview",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win nsis",
    "build:portable": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win portable"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cross-env": "^10.1.0",
    "electron": "^39.4.1",
    "electron-builder": "^26.4.0",
    "lucide": "^1.47.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "music-metadata": "^12.5.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.wolffia.app",
    "productName": "Wolffia",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Wolffia-${version}-electron-setup.${ext}"
    },
    "portable": {
      "artifactName": "Wolffia-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
